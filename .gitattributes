# Vendored upstream Skills and LICENSE are verified against exact byte hashes.
skills/ai-manju-skills/** -text
# 古手梨花合集原件按字节校验，不能被 core.autocrlf 改写。
presets/gushoulihua-skills/** -text
# MOSS 提示词套件原件按字节校验，同样禁止行尾转换。
presets/moss-prompt-kit/** -text
# 审核后的创作模板正文按哈希校验。
presets/creative-prompt-kit/** -text
# Recipe templates and license carry byte-level provenance hashes.
naiba/super_agent/recipe_assets/** -text
# 预设由转换器按 LF 生成，Windows checkout 必须保持字节可复现。
public/studio/*.json text eol=lf
# GenUI 资源按引入字节验指纹，保持上游行尾和空白。
public/vendor/genui/**/*.js -text -whitespace
