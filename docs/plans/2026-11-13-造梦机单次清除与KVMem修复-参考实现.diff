+    return result
+
+
+def write_last_start(path: Any, manager_url: str, parameters: Any) -> None:
+    """记住这次成功启动的参数；写失败不影响启动本身。"""
+    picked = _pick_parameters(parameters)
+    if not manager_url or not picked.get("Model"):
+        return
+    target = Path(path)
